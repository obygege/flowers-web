diff a/views/cart.html b/views/cart.html	(rejected hunks)
@@ -1 +1 @@
-<!doctype html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Keranjang - Mahira Flowers</title><link rel="stylesheet" href="/css/customer.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"></head><body><header class="customer-header"><a class="brand" href="/">Mahira Flowers</a><nav data-customer-account><a href="/">Beranda</a></nav></header><main class="page-shell"><div class="page-heading"><div><p class="eyebrow">Pesanan Anda</p><h1>Keranjang</h1><p class="muted">Atur jumlah rangkaian sebelum melanjutkan pemesanan.</p></div></div><section class="result-panel"><div id="items"></div><div id="summary"></div></section></main><script src="/js/customer.js"></script><script>async function load(){if(!requireCustomer())return;try{const d=await customerFetch('/api/cart');const items=d.data||[];document.getElementById('items').innerHTML=items.map(i=>`<div class="cart-row"><img src="${safe(i.image_url)}" alt="${safe(i.name)}"><div><h3>${safe(i.name)}</h3><div class="price">${money(i.price)}</div></div><div class="qty"><button data-dec="${i.product_id}">-</button><strong>${i.quantity}</strong><button data-inc="${i.product_id}">+</button></div><button class="btn btn-light" data-remove="${i.product_id}" title="Hapus"><i class="fa-solid fa-trash"></i></button></div>`).join('')||'<div class="empty">Keranjang masih kosong.</div>';document.getElementById('summary').innerHTML=items.length?`<div class="total-row"><span>Total</span><span>${money(items.reduce((s,i)=>s+Number(i.price)*i.quantity,0))}</span></div><p class="message">Pilih produk pada landing page untuk mengisi detail pengiriman dan mengirim pesanan.</p>`:'';}catch(e){document.getElementById('items').innerHTML=`<div class="empty">${safe(e.message)}</div>`}}document.addEventListener('click',async e=>{const inc=e.target.closest('[data-inc]'),dec=e.target.closest('[data-dec]'),remove=e.target.closest('[data-remove]');try{if(inc||dec){const id=(inc||dec).dataset[inc?'inc':'dec'];const row=(inc||dec).closest('.cart-row');const qty=Number(row.querySelector('strong').textContent)+(inc?1:-1);if(qty>0)await customerFetch('/api/cart/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({quantity:qty})});else await customerFetch('/api/cart/'+id,{method:'DELETE'});load()}if(remove){await customerFetch('/api/cart/'+remove.dataset.remove,{method:'DELETE'});load()}}catch(err){alert(err.message)}});load();</script></body></html>
+<!doctype html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Keranjang - Mahira Flowers</title><link rel="stylesheet" href="/css/customer.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"></head><body><header class="customer-header"><a class="brand" href="/">Mahira Flowers</a><nav data-customer-account><a href="/">Beranda</a></nav></header><main class="page-shell"><div class="page-heading"><div><p class="eyebrow" data-i18n="cart_eyebrow">Pesanan Anda</p><h1 data-i18n="cart_title">Keranjang</h1><p class="muted" data-i18n="cart_desc">Atur jumlah rangkaian sebelum melanjutkan pemesanan.</p></div></div><section class="result-panel"><div id="items"></div><div id="summary"></div></section></main><script src="/js/customer.js"></script><script>async function load(){if(!requireCustomer())return;const dict=customerTranslations[customerLang()];try{const d=await customerFetch('/api/cart?lang='+encodeURIComponent(customerLang()));const items=d.data||[];document.getElementById('items').innerHTML=items.map(i=>`<div class="cart-row"><img src="${safe(i.image_url)}" alt="${safe(i.name)}"><div><h3>${safe(i.name)}</h3><div class="price">${money(i.price)}</div></div><div class="qty"><button data-dec="${i.product_id}">-</button><strong>${i.quantity}</strong><button data-inc="${i.product_id}">+</button></div><button class="btn btn-light" data-remove="${i.product_id}" title="Hapus"><i class="fa-solid fa-trash"></i></button></div>`).join('')||`<div class="empty">${dict.cart_empty}</div>`;document.getElementById('summary').innerHTML=items.length?`<div class="total-row"><span>${dict.cart_total}</span><span>${money(items.reduce((s,i)=>s+Number(i.price)*i.quantity,0))}</span></div><p class="message">${dict.cart_note}</p>`:'';}catch(e){document.getElementById('items').innerHTML=`<div class="empty">${safe(e.message)}</div>`}}document.addEventListener('mahira-lang-changed',load);document.addEventListener('click',async e=>{const inc=e.target.closest('[data-inc]'),dec=e.target.closest('[data-dec]'),remove=e.target.closest('[data-remove]');try{if(inc||dec){const id=(inc||dec).dataset[inc?'inc':'dec'];const row=(inc||dec).closest('.cart-row');const qty=Number(row.querySelector('strong').textContent)+(inc?1:-1);if(qty>0)await customerFetch('/api/cart/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({quantity:qty})});else await customerFetch('/api/cart/'+id,{method:'DELETE'});load()}if(remove){await customerFetch('/api/cart/'+remove.dataset.remove,{method:'DELETE'});load()}}catch(err){alert(err.message)}});load();</script></body></html>
